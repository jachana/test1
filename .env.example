# Copy to .env and adjust as needed. All variables are optional; defaults work
# for local development.

# --- Backend -------------------------------------------------------------
# Comma-separated list of allowed CORS origins for the API.
STARMAP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Nominatim geocoding: set a real contact per OSM usage policy.
STARMAP_GEOCODE_USER_AGENT=starmap-laser-mvp/0.1 (contact: you@example.com)
STARMAP_GEOCODE_URL=https://nominatim.openstreetmap.org/search

# Maximum request body size in bytes.
STARMAP_MAX_REQUEST_BYTES=65536

# --- Frontend ------------------------------------------------------------
# URL the Next.js dev/prod server proxies /api/* to.
BACKEND_URL=http://localhost:8000
